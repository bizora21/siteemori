# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo
next-env.d.ts

# Lockfile omitido do repo: gerado em Windows, o CI do Cloudflare corre em Linux
# e o npm ci rejeita locks cruzados de SO. O Cloudflare usa npm install sem lock.
package-lock.json

# Assets sociais gerados (derivados do manifest — regenerar com `npm run social`)
/social/

# Ferramentas locais de geração (binário do Piper + modelos de voz, ~75MB).
# Descarregadas com `npm run tts:setup` — não fazem sentido num repo de código.
/tools/
/tmp-tts/

# Áudio de fundo dos vídeos (Pixabay Content License: permite usar, mas NÃO
# redistribuir o ficheiro autonomamente — por isso fica fora deste repo público).
# Coloca a tua faixa em assets/audio/calm.mp3; o gerador usa-a se existir.
/assets/audio/

# Cache dos clips de fundo do Pexels. Licença Pexels permite uso comercial, mas
# não faz sentido versionar vídeo binário — regenera-se sozinho na 1ª geração.
/assets/video-bg/
