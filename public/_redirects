# Cloudflare redirects
# Raiz → variante primária (PT-BR). 301 (permanente) para o Google consolidar
# os sinais em /pt-br/ e não indexar aemori.com/ como URL duplicado.
/                 /pt-br/            301

# Atalhos sem barra final para as variantes
/pt-br            /pt-br/            301
/pt-pt            /pt-pt/            301

# Aliases de conveniência (opcional)
/br/*             /pt-br/:splat      301
/pt/*             /pt-pt/:splat      301
