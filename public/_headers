# Cloudflare Pages headers

# Segurança básica em todas as páginas
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # HSTS moderado para site novo (6 meses, sem preload). Quando o HTTPS estiver
  # comprovadamente estável, dá para subir para max-age=31536000 e adicionar
  # "preload" + submeter em hstspreload.org.
  Strict-Transport-Security: max-age=15552000; includeSubDomains

# Assets estáticos do Next com hash → cache imutável
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Digital Asset Links: content-type correto e cache CURTO (validações da Play
# refazem o fetch; um cache longo faz o Google ver versões desatualizadas).
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=300
